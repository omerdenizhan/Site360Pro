APP_NAME=Site360Pro
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Varsayılan veritabanı SQLite'tır (database/database.sqlite).
DB_CONNECTION=sqlite
# MySQL kullanacaksanız:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=site360pro
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# Duyuruların e-posta ile gönderilmesi için SMTP bilgileri
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="destek@example.com"
MAIL_FROM_NAME="${APP_NAME}"
